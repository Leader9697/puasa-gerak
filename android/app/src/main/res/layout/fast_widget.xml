<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_orange">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PUASA &amp; GERAK"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/w_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:maxLines="1" />

    <TextView
        android:id="@+id/w_idle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Belum puasa"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ketuk untuk membuka"
        android:textColor="#E6FFFFFF"
        android:textSize="13sp"
        android:maxLines="1" />
</LinearLayout>
